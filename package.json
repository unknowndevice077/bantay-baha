{
  "name": "bantay-baha",
  "version": "1.0.0",
  "description": "Interactive 3D flood-monitoring simulator of a Philippine barangay with an ESP32 ultrasonic water-level sensor.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/three": "^0.169.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
